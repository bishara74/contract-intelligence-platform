# Backend Environment Variables
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/contract_intel

# OpenAI
OPENAI_API_KEY=sk-...

# Pinecone
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=contract-intelligence

# Cloudflare R2
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=contract-intelligence

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# AWS DynamoDB
USE_DYNAMODB=false
AWS_REGION=eu-central-1
DYNAMODB_TABLE_NAME=contract-intel-chat-messages
DYNAMODB_ENDPOINT_URL=
AWS_ACCESS_KEY_ID_DYNAMO=
AWS_SECRET_ACCESS_KEY_DYNAMO=

# CORS
CORS_ORIGINS=http://localhost:5173
